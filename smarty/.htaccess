# The Smarty library, the templates and the compiled templates must never be
# served directly. PHP can still read them from disk; .htaccess only blocks
# HTTP access.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
