# vea configuration example.
#
# Copy this file to ".env" and adjust the values, or set the variables in the
# web server / container instead (recommended: then no file is needed).
#
# Keep the real .env file OUT of version control and, ideally, outside the web
# root. When it lives outside the web root, point vea at it with VEA_ENV_FILE,
# for example in the Apache vhost:
#
#     SetEnv VEA_ENV_FILE /etc/vea/.env

# --- Database (PostgreSQL) --------------------------------------------
VEA_DB_HOST=127.0.0.1
VEA_DB_NAME=mailserver
VEA_DB_USER=mailadmin
# Required: vea refuses to start while this is empty.
VEA_DB_PASS=

# --- Optional ---------------------------------------------------------
# Comma-separated addresses of trusted reverse proxies whose
# X-Forwarded-Proto header may be believed when deciding whether the request
# arrived over TLS.
#VEA_TRUSTED_PROXIES=10.0.0.5,::1

# Comma-separated allow-list of accepted login names. Empty = accept any
# username the web server authenticated.
#VEA_AUTH_USERS=admin

# HTTP Basic authentication realm.
#VEA_AUTH_REALM=vea
